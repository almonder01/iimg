{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/almonder01/iimg/main/spec/schemas/metadata.schema.json",
  "title": "IIMG Core 1.0 candidate META",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "width", "height", "required"],
  "properties": {
    "profile": { "const": "iimg-core-1" },
    "width": { "$ref": "common.schema.json#/$defs/side" },
    "height": { "$ref": "common.schema.json#/$defs/side" },
    "required": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["raster-png", "toggle-fill", "state-actions", "motion-linear"] },
      "allOf":[{"if":{"contains":{"const":"motion-linear"}},"then":{"contains":{"const":"state-actions"}}}],
      "not": {"allOf":[{"contains":{"const":"toggle-fill"}},{"contains":{"const":"state-actions"}}]}
    }
  }
}
