{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/almonder01/iimg/main/spec/schemas/source.schema.json",
  "title": "IIMG visual authoring source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "height",
    "scene"
  ],
  "properties": {
    "width": {
      "$ref": "common.schema.json#/$defs/side"
    },
    "height": {
      "$ref": "common.schema.json#/$defs/side"
    },
    "scene": {
      "$ref": "scene.schema.json"
    },
    "motion": {
      "anyOf": [
        {
          "$ref": "motion.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "interaction": {
      "anyOf": [
        {
          "$ref": "interaction.schema.json"
        },
        {
          "$ref": "state-actions.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "assets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "png_base64"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "png_base64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1398104,
            "contentEncoding": "base64",
            "description": "The Core compiler validates the Base64 and bounded RGB8 PNG data."
          },
          "text": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "font_family",
                  "font_size",
                  "direction",
                  "color",
                  "background"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "font_family": {
                    "enum": [
                      "sans-serif",
                      "serif",
                      "monospace"
                    ]
                  },
                  "font_size": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 128
                  },
                  "direction": {
                    "enum": [
                      "ltr",
                      "rtl"
                    ]
                  },
                  "color": {
                    "$ref": "common.schema.json#/$defs/color"
                  },
                  "background": {
                    "$ref": "common.schema.json#/$defs/color"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "drag": {
      "anyOf": [
        {
          "$ref": "drag.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "accessibility": {
      "anyOf": [
        {
          "$ref": "accessibility.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
