{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/almonder01/iimg/main/spec/schemas/trace.schema.json",
  "title": "IIMG portable replay trace version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "events"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "events": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "x", "y"],
            "properties": {
              "type": { "const": "activate_pixel" },
              "x": { "$ref": "common.schema.json#/$defs/coordinate" },
              "y": { "$ref": "common.schema.json#/$defs/coordinate" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["focus_next", "focus_previous", "activate_focused", "reset"] }
            }
          }
        ]
      }
    }
  }
}
