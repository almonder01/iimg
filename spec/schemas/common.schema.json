{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/almonder01/iimg/main/spec/schemas/common.schema.json",
  "title": "IIMG Core candidate shared types",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": { "pattern": "[^A-Za-z0-9_-]" }
    },
    "color": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    },
    "side": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "coordinate": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "extent": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": { "pattern": "[\u0000-\u001f\u007f-\u009f]" },
      "description": "The Core reader also enforces the UTF-8 byte limit and rejects labels empty after trimming Unicode whitespace."
    }
  }
}
