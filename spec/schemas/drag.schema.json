{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/almonder01/iimg/main/spec/schemas/drag.schema.json",
  "title": "Draft discrete DRAG sliders",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sliders"
  ],
  "properties": {
    "sliders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "label",
          "axis",
          "min",
          "max",
          "step",
          "initial",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "target": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/label"
          },
          "axis": {
            "enum": [
              "x",
              "y"
            ]
          },
          "min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "initial": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "from": {
            "$ref": "motion.schema.json#/$defs/point"
          },
          "to": {
            "$ref": "motion.schema.json#/$defs/point"
          }
        }
      }
    }
  }
}
